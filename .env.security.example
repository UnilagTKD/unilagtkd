# Copy names into your host's private environment settings; never commit values.
# Apply migrations/20261117_security.sql BEFORE deploying this security update.
# Production rate limits fail closed if their database table is absent/unavailable.

# Enable only if your hosting proxy strips/replaces user-supplied forwarding headers.
TRUST_PROXY_HEADERS=false

# Optional stronger protection for contact/registration forms. Configure BOTH.
# Add unilagtaekwondo.org and portal.unilagtaekwondo.org in your Turnstile widget settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional signed image hosting. With these unset, validated data URLs are used.
# Disable any previously public unsigned Cloudinary preset in Cloudinary itself.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing server-only variables: DATABASE_URL, AUTH_SECRET, RESEND_API_KEY, EMAIL_FROM.
CRON_SECRET=
# Set a long random secret on the host to authorize the monthly-summary job.
# AUTH_URL and the two public domain origins are in .env.domains.example.
