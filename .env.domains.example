# Configure these on the deployed app before building. Leave unset for local development.
NEXT_PUBLIC_SITE_URL=https://unilagtaekwondo.org
NEXT_PUBLIC_PORTAL_URL=https://portal.unilagtaekwondo.org
AUTH_URL=https://portal.unilagtaekwondo.org
# After verifying unilagtaekwondo.org in Resend, configure the sender:
# EMAIL_FROM="UNILAG Taekwondo Club <portal@unilagtaekwondo.org>"
EMAIL_REPLY_TO=unilagtkd@gmail.com
# Keep AUTH_SECRET private and unchanged across deployments.
# Attach both domains to the same app in your hosting provider and configure DNS/TLS there.
